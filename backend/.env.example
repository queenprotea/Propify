# Plantilla de variables de entorno. Copiar a .env y rellenar con valores reales.
# El archivo .env real NUNCA debe versionarse.

# --- Base de datos ---
DB_USER=inmobiliaria_user
DB_PASSWORD=pon_un_password_seguro
DB_NAME=inmobiliaria_db
# Debe coincidir con DB_USER / DB_PASSWORD / DB_NAME de arriba.
DATABASE_URL=postgresql://inmobiliaria_user:pon_un_password_seguro@db:5432/inmobiliaria_db

# --- JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# user-service y property-service deben compartir EXACTAMENTE la misma SECRET_KEY.
SECRET_KEY=genera_una_clave_aleatoria_de_64_hex
ALGORITHM=HS256

# --- Stripe (payment-service) ---
STRIPE_SECRET_KEY=sk_test_xxx
WEBHOOK_SECRET=whsec_xxx
