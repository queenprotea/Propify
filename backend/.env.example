# Plantilla de variables de entorno. Copiar a .env y rellenar con valores reales.
# El archivo .env real NUNCA debe versionarse.

# --- Base de datos ---
DB_USER=inmobiliaria_user
DB_PASSWORD=pon_un_password_seguro
DB_NAME=inmobiliaria_db
# Debe coincidir con DB_USER / DB_PASSWORD / DB_NAME de arriba.
DATABASE_URL=postgresql://inmobiliaria_user:pon_un_password_seguro@db:5432/inmobiliaria_db

# --- JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# user-service y property-service deben compartir EXACTAMENTE la misma SECRET_KEY.
SECRET_KEY=genera_una_clave_aleatoria_de_64_hex
ALGORITHM=HS256

# --- Stripe (modo prueba) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
WEBHOOK_SECRET=whsec_xxx

# --- SMTP (correo de verificación) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=app_password_de_gmail
SMTP_FROM=tucorreo@gmail.com

# --- Despliegue ---
# URL pública desde donde se accede (para los enlaces de verificación de correo).
# Local: http://localhost:3000   Producción: http://<IP_PUBLICA>  o  https://tudominio.com
FRONTEND_URL=http://localhost:3000
# Puerto del frontend en el host. Local: 3000   Producción (VM): 80
FRONTEND_PORT=3000
